# Server & Network Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/jiyonkathi_db
DB_HOST=localhost
DB_USER=jiyonkathi_admin
DB_PASSWORD=secret_password
DB_NAME=jiyonkathi_db
DB_PORT=5432

# Firebase Storage Configuration (Low-cost media storage for images & videos)
FIREBASE_PROJECT_ID=jiyonkathi-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jiyonkathi-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=jiyonkathi-app.appspot.com

# Domain & CORS Configuration
DOMAIN_NAME=jiyonkathi.org
# APP_URL=https://jiyonkathi.org
